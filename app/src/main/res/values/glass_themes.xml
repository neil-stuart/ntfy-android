<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Frosted pane: translucent fill, hairline highlight edge, no shadow
         (a shadow under a translucent surface shows through as a smudge). -->
    <style name="GlassCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/glassPane</item>
        <item name="strokeColor">?attr/glassBorderTop</item>
        <item name="strokeWidth">@dimen/glass_stroke_width</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Hawksfield.Glass</item>
    </style>

    <style name="ShapeAppearance.Hawksfield.Glass" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/glass_corner</item>
    </style>

    <style name="ThemeOverlay.Hawksfield.GlassDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/Hawksfield.GlassDialog</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>

    <style name="Hawksfield.GlassDialog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/glassDialog</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Hawksfield.Glass</item>
    </style>

    <!-- Nocean-style chrome: large Inter title, mono caps subtitle, round glass buttons -->
    <style name="Home.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Home.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Home.Mono.Caps</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <style name="Home.GlassActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:background">@drawable/glass_pill</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Home.GlassNavigationButton" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="android:background">@drawable/glass_circle</item>
        <item name="android:minWidth">48dp</item>
    </style>

    <style name="TextAppearance.Home.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Home.ItemTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Home.Mono" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/geist_mono</item>
        <item name="fontFamily">@font/geist_mono</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Home.Mono.Caps">
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Home.FooterLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
