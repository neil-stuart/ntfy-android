<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar action buttons: a 40dp-tall glass pill, vertically centred. On a 48dp icon button it
     is a circle; on a text button (e.g. "Subscribe") it widens into a capsule around the label. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:height="40dp" android:gravity="center_vertical|fill_horizontal"
        android:left="4dp" android:right="4dp">
        <ripple android:color="?attr/colorControlHighlight">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="?attr/glassPane" />
                    <stroke android:width="@dimen/glass_stroke_width" android:color="?attr/glassBorderTop" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
